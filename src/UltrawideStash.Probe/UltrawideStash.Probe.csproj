<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 because that is what the game's mono runtime loads. -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>UltrawideStash.Probe</RootNamespace>
    <AssemblyName>UltrawideStash.Probe</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Must match ProbePlugin.PluginVersion. Two places, and they have to agree. -->
    <Version>1.0.0</Version>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <SPTPath Condition="'$(SPTPath)' == ''">C:\HUH</SPTPath>
    <GameManaged>$(SPTPath)\EscapeFromTarkov_Data\Managed</GameManaged>
    <BepInExCore>$(SPTPath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')"
           Text="SPTPath ('$(SPTPath)') is not an SPT install root: no BepInEx\core\BepInEx.dll." />
  </Target>

  <!--
    Deliberately NOT referenced: Assembly-CSharp. The copy in Managed is the
    unpatched original on any install that has never been launched, and the SPT
    Launcher's delta renames obfuscated types, so a plugin compiled against it does
    not load. Every game member is resolved by patched name at runtime instead; see
    GameTypes.cs. Nothing below is the game's own code.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The facade. BepInEx's BaseUnityPlugin derives from MonoBehaviour as typed
      against this assembly, so the compile needs it even though every type actually
      used lives in CoreModule.
    -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MonoBehaviour, Component, RectTransform, Screen, Mathf. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Canvas and its scaleFactor, for the logical-size line. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>





