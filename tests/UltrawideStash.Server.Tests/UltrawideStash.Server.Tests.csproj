<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!--
      With its runtime assets, unlike the mod, which excludes them so the zip does not
      ship a second copy of SPT into the server. LoadedProfileTests builds real Item
      objects, and the test host has no server around it to supply the types.
    -->
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltrawideStash.Server\UltrawideStash.Server.csproj" />
  </ItemGroup>

  <!--
    The probe's layout planner, compiled in directly. The probe is net472 against the
    game's Unity assemblies and cannot be referenced from here, but this one file is
    pure arithmetic with no engine type in it, which is what makes it testable.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\UltrawideStash.Probe\ScreenLayout.cs" Link="Probe\ScreenLayout.cs" />
  </ItemGroup>

</Project>
